{
  "manifest_version": 3,
  "name": "Single NewTab",
  "version": "1.1.0",
  "description": "限制只能打开一个新标签页，支持壁纸不喜欢标记与导出",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "file:///*"
  ]
}